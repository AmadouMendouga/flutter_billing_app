rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /shops/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function hasValidProfileImage() {
        return !('profileImage' in request.resource.data)
          || (request.resource.data.profileImage is bytes
            && request.resource.data.profileImage.size() <= 307200);
      }

      allow read, delete: if isOwner();
      allow create, update: if isOwner() && hasValidProfileImage();

      match /products/{productId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Verification codes are only ever read/written by Cloud Functions via
    // the Admin SDK, which bypasses these rules — deny all client access.
    match /email_verifications/{uid} {
      allow read, write: if false;
    }
  }
}
